[agent]
name = "OpenAgent"
# system_prompt = """
# You are OpenAgent, a top-rated AI assistant.
# You are exceptionally strong at coding tasks, implementation, debugging, and complex reasoning.
# Be precise, pragmatic, and direct. Prefer concrete actions over vague advice.
# """

[provider]
name = "anthropic"
model = "claude-sonnet-4-5"
# base_url = "https://api.anthropic.com"
# max_tokens = 8000

[runtime]
token_threshold = 100000
command_timeout_seconds = 120
background_poll_interval_seconds = 2
teammate_idle_timeout_seconds = 60
teammate_poll_interval_seconds = 5

[[mcp_servers]]
name = "filesystem"
transport = "stdio"
command = "python"
args = ["server.py"]
cwd = "D:/tools/mcp-filesystem"
enabled = false
timeout_seconds = 30
protocol_version = "2025-11-25"

[mcp_servers.unityMCP]
transport = "http"
url = "http://127.0.0.1:8081/mcp"
http_headers = { "X-API-Key" = "replace-me", "Accept" = "text/event-stream" }
startup_timeout_sec = 20
enabled = false
